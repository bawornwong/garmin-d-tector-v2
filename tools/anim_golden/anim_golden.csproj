<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>anim_golden</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0414;CS0649;CS0168;CS0219</NoWarn>
    <!-- Set DTECTOR_SRC to a checkout of kaisadilla/D-Tector-v2 -->
    <DTectorSrc>$(DTECTOR_SRC)</DTectorSrc>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/*.cs" />
    <!-- The ORIGINAL animation file, compiled straight out of the checkout:
         the golden has to come from the source, not from a copy of it. -->
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/Data/Animations.cs" />
  </ItemGroup>
</Project>
