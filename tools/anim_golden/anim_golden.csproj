<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>anim_golden</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0414;CS0649;CS0168;CS0219</NoWarn>
    <!-- Set DTECTOR_SRC to a checkout of kaisadilla/D-Tector-v2 -->
    <DTectorSrc>$(DTECTOR_SRC)</DTectorSrc>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/*.cs" />
    <!-- The ORIGINAL animation file, compiled straight out of the checkout:
         the golden has to come from the source, not from a copy of it. -->
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/Data/Animations.cs" />
    <!-- And the Status app, whose screens are diffed the same way: what a
         screen builds is a display list like any other. -->
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/Apps/Status.cs" />
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/Apps/DatabaseApp.cs" />
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/Apps/Map.cs" />
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/Apps/Games/Battle.cs" />
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/AttackChooser.cs" />
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/Apps/CodeInput.cs" />
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/Apps/Games/DigiHunter.cs" />
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/Apps/Camp.cs" />
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/Apps/Games/Finder.cs" />
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/Apps/Games/JackpotBox.cs" />
    <!-- CircularAdd, which Status walks its screens with: the original's own
         arithmetic rather than a copy of it. -->
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/Extensions/MathExt.cs" />
    <!-- The Digimon model: the stats a database page prints are its
         arithmetic, not a copy of it. -->
    <Compile Include="$(DTectorSrc)/Assets/Scripts/Logic/Models/Digimon.cs" />
  </ItemGroup>
</Project>
